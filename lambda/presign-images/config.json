{
    "functionName": "troySandboxPresignImages",
    "runtime": "nodejs22.x",
    "handler": "index.handler",
    "memoryMB": 256,
    "timeoutSeconds": 15,
    "reservedConcurrency": 10,
    "environmentVariables": {
        "IMAGES_BUCKET": "troy-sandbox-images.vpmdevtech.com",
        "SANDBOX_KEY": "<paste-generated-sandbox-key-here>",
        "ALLOWED_ORIGIN": "https://visionpointmarketing.github.io"
    },
    "functionUrl": {
        "authType": "NONE",
        "cors": {
            "allowOrigins": ["https://visionpointmarketing.github.io"],
            "allowMethods": ["POST", "OPTIONS"],
            "allowHeaders": ["Content-Type", "X-Sandbox-Key"],
            "maxAgeSeconds": 3600
        }
    },
    "executionRoleName": "troy-sandbox-lambda-presignImages",
    "tags": {
        "Project": "troy-sandbox",
        "Phase": "1"
    }
}
