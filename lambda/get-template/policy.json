{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadTemplatesTable",
            "Effect": "Allow",
            "Action": [
                "dynamodb:GetItem"
            ],
            "Resource": "arn:aws:dynamodb:us-east-1:831326375124:table/TroySandbox_Templates"
        },
        {
            "Sid": "BasicLambdaLogging",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:us-east-1:831326375124:log-group:/aws/lambda/troySandboxGetTemplate:*"
        }
    ]
}
